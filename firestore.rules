rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Master Soul Profile subcollection
      match /profiles/{profileId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // DLAS evaluations subcollection
      match /dlasEvaluations/{evalId} {
        allow read, write: if isOwner(userId);
      }

      // Journey tasks subcollection
      match /journeyTasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // User AI Artifacts (generated images, videos, thinking summaries)
      match /aiArtifacts/{artifactId} {
        allow read, write: if isOwner(userId);
      }

      // User Chat sessions and messages
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Two-Way Marketplace listings
    match /marketplaceListings/{listingId} {
      allow read: if true; // Public read for all citizens
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Global audit trail
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
